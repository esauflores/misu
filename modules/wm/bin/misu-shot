#!/usr/bin/env bash
# misu-shot region|output: screenshot to ~/Pictures/Screenshots and the clipboard.

dir=$HOME/Pictures/Screenshots
mkdir -p "$dir"
file=$dir/"Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"

case ${1:-region} in
  region)
    geom=$(slurp) || exit 0
    grim -g "$geom" "$file"
    ;;
  output)
    out=$(scrollmsg -t get_outputs | jq -r '.[] | select(.focused) | .name')
    grim -o "$out" "$file"
    ;;
  *)
    echo "usage: misu-shot region|output" >&2
    exit 2
    ;;
esac

wl-copy --type image/png <"$file"
notify-send -a Screenshot -i "$file" "Screenshot saved" "$(basename "$file")"
