#!/usr/bin/env bash
# misu-shot region|output: screenshot with pointers to ~/Pictures/Screenshots and the clipboard.

set -euo pipefail

dir=$HOME/Pictures/Screenshots

# Set $file to a new name in $dir, numbered when this second's name is taken.
new_file() {
  local base n=1
  mkdir -p "$dir"
  base=$dir/"Screenshot from $(date '+%Y-%m-%d %H-%M-%S')"
  file=$base.png
  while [[ -e $file ]]; do
    n=$((n + 1))
    file="$base ($n).png"
  done
}

die() {
  echo "misu-shot: $*" >&2
  exit 1
}

usage() {
  echo "usage: misu-shot region|output" >&2
  exit 2
}

# Screen shown to the user's seat, independent of agent focus.
focused_output() {
  wm msg tree | jq -r '.result | . as $tree | .seats[] | select(.id == 0) | .screen as $id | $tree.screens[] | select(.id == $id) | .name'
}

new_file
case ${1:-region} in
  region)
    geom=$(slurp) || exit 0
    grim -c -g "$geom" "$file"
    ;;
  output)
    grim -c -o "$(focused_output)" "$file"
    ;;
  *)
    usage
    ;;
esac

wl-copy --type image/png <"$file"
notify-send -a Screenshot -i "$file" "Screenshot saved" "$(basename "$file")"
