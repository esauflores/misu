#!/usr/bin/env python3
"""Pick a configured wm binding with fuzzel and run it through IPC."""
import json
import os
from pathlib import Path
import subprocess
config = json.loads((Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'wm/config.json').read_text())
choices = {key.replace('Mod+', 'Super+') + '  ' + cmd: cmd
           for key, cmd in config['bindings'].items() if cmd}
menu = subprocess.run(['fuzzel', '--dmenu', '--width', '90', '--prompt', 'keys  '],
                      input='\n'.join(choices), text=True, capture_output=True)
if menu.returncode == 0 and menu.stdout.strip() in choices:
    raise SystemExit(subprocess.run(['wm', 'msg', 'seat', '0', choices[menu.stdout.strip()]]).returncode)
