#!/usr/bin/env bash
# misu-session: the greeter's Misu entry; sets the Wayland environment and starts wm.

# mise's shims, so tools it installs (the AI CLIs) also reach apps started
# outside a shell: wm bindings, the bar.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export ELECTRON_OZONE_PLATFORM_HINT=auto QT_WAYLAND_DISABLE_WINDOWDECORATION=1 GSK_RENDERER=gl _JAVA_AWT_WM_NONREPARENTING=1
export QT_QPA_PLATFORM='wayland;xcb' GDK_BACKEND='wayland,x11,*'
# Qt apps (the bar too) take theme's qt6ct.conf: Adwaita style and icons.
export QT_QPA_PLATFORMTHEME=qt6ct
export XCURSOR_THEME=Bibata-Modern-Ice XCURSOR_SIZE=20

# The login's user bus (/run/user/<uid>/bus), the one systemd's user services
# (gnome-keyring's Secret Service, the portals) are on, not a private one.
export XDG_CURRENT_DESKTOP=wm XDG_SESSION_DESKTOP=wm XDG_SESSION_TYPE=wayland
# `wm msg restart` (Super+Ctrl+Shift+Q) exits 75: start wm again (a new
# build, the config regenerated) without going back to the greeter. Apps
# close either way; startup brings the bar and the rest back.
while :; do
  config=$(misu-wm-config) || exit 1
  wm --backend drm --config "$config"
  status=$?
  [[ $status == 75 ]] || exit "$status"
done
