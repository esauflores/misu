#!/usr/bin/env python3
"""Merge Misu's config and the wallpaper palette without changing the checkout."""
import json
import os
from pathlib import Path
import tempfile
home = Path.home()
source = Path(os.environ.get('XDG_CONFIG_HOME', home / '.config')) / 'wm/config.json'
state = Path(os.environ.get('XDG_STATE_HOME', home / '.local/state')) / 'rice'
config = json.loads(source.read_text())
palette = state / 'wm-colors.json'
if palette.exists():
    config['colors'] = json.loads(palette.read_text())
state.mkdir(parents=True, exist_ok=True)
with tempfile.NamedTemporaryFile(mode='w', dir=state, delete=False) as output:
    json.dump(config, output, indent=2)
    output.write('\n')
os.replace(output.name, state / 'wm-config.json')
print(state / 'wm-config.json')
